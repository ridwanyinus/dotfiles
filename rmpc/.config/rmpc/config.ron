#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    address: "/tmp/mpd_socket",
    password: None,
    theme: Some("current.ron"),
    cache_dir: Some("~/.cache/rmpc"),
    on_song_change: ["~/.config/rmpc/scripts/getlyrics"],
    volume_step: 5,
    max_fps: 30,
    scrolloff: 0,
    wrap_navigation: false,
    enable_mouse: true,
    enable_config_hot_reload: true,
    enable_lyrics_hot_reload: false,
    lyrics_dir: Some("~/Music/"),
    lyrics_offset_ms: 10,
    status_update_interval_ms: 1000,
    rewind_to_start_sec: None,
    keep_state_on_song_change: true,
    reflect_changes_to_playlist: false,
    select_current_song_on_change: true,
    ignore_leading_the: false,
    browser_song_sort: [Disc, Track, Filename, Artist, Title],
    browser_column_widths: [20, 38, 42],
    directories_sort: SortFormat(group_by_type: true, reverse: false),
    auto_open_downloads: true,
    album_art: (
        method: Auto,
        max_size_px: (width: 0, height: 0),
        disabled_protocols: [],
        vertical_align: Center,
        horizontal_align: Center,
    ),
    keybinds: (
        global: {
            "q":          Quit,
            "?":          ShowHelp,
            ":":          CommandMode,

            "p":          TogglePause,
            "s":          Stop,
            "z":          ToggleRepeat,
            "x":          ToggleRandom,
            "c":          ToggleConsume,
            "v":          ToggleSingle,

            ">":          NextTrack,
            "<":          PreviousTrack,
            "f":          SeekForward,
            "b":          SeekBack,

            "+":          VolumeUp,
            "=":          VolumeUp,
            "_":          VolumeDown,

            "u":          Update,
            "U":          Rescan,
            "R":          AddRandom,

            "<Tab>":      NextTab,
            "gt":         NextTab,
            "<S-Tab>":    PreviousTab,
            "gT":         PreviousTab,

            "1":          SwitchToTab("Queue"),
            "2":          SwitchToTab("Directories"),
            "3":          SwitchToTab("Artists"),
            "4":          SwitchToTab("Genre"),
            "5":          SwitchToTab("Show"),
            "6":          SwitchToTab("Playlists"),
            "7":          SwitchToTab("Search"),

            "oI":         ShowCurrentSongInfo,
            "oo":         ShowOutputs,
            "op":         ShowDecoders,
            "od":         ShowDownloads,
            "oP":         Partition(),
            "]": CrossfadeUp,
            "[": CrossfadeDown,
        },
        navigation: {
            "<Esc>":      Close,
            "<C-c>":      Close,
            "<CR>":       Confirm,

            "k":          Up,
            "<Up>":       Up,
            "j":          Down,
            "<Down>":     Down,
            "h":          Left,
            "<Left>":     Left,
            "l":          Right,
            "<Right>":    Right,

            "gg":         Top,
            "G":          Bottom,

            "<C-u>":      UpHalf,
            "<C-d>":      DownHalf,
            "<C-b>":      PageUp,
            "<PageUp>":   PageUp,
            "<C-f>":      PageDown,
            "<PageDown>": PageDown,

            "K":          MoveUp,
            "J":          MoveDown,

            "<C-w>k":     PaneUp,
            "<C-Up>":     PaneUp,
            "<C-w>j":     PaneDown,
            "<C-Down>":   PaneDown,
            "<C-w>h":     PaneLeft,
            "<C-Left>":   PaneLeft,
            "<C-w>l":     PaneRight,
            "<C-Right>":  PaneRight,

            "<Space>":    Select,
            "<C-Space>":  InvertSelection,

            "/":          EnterSearch,
            "n":          NextResult,
            "N":          PreviousResult,

            "a":          Add,
            "A":          AddAll,
            "D":          Delete,
            "r":          Rename,

            "i":          FocusInput,
            "oi":         ShowInfo,

            "<C-z>":      ContextMenu(),
            "<C-s>s":     Save(kind: Modal(all: false, duplicates_strategy: Ask)),
            "<C-s>a":     Save(kind: Modal(all: true, duplicates_strategy: Ask)),
        },
        queue: {
            "d":          Delete,
            "D":          DeleteAll,
            "<CR>":       Play,
            "C":          JumpToCurrent,
            "X":          Shuffle,
        },
    ),
    search: (
        case_sensitive: false,
        ignore_diacritics: false,
        search_button: false,
        mode: Contains,
        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "artist",      label: "Artist"),
            (value: "album",       label: "Album"),
            (value: "albumartist", label: "Album Artist"),
            (value: "title",       label: "Title"),
            (value: "filename",    label: "Filename"),
            (value: "genre",       label: "Genre"),
        ],
    ),
    cava: (
        framerate: 60,
        autosens: true,
        sensitivity: 100,
        lower_cutoff_freq: 50,
        higher_cutoff_freq: 10000,
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),
        smoothing: (
            noise_reduction: 77,
            monstercat: false,
            waves: true,
        ),
        eq: []
    ),
    artists: (
        album_display_mode: NameOnly,
        album_sort_by: Date,
        album_date_tags: [Date],
    ),
    tabs: [
        (name: "Queue", pane: Split(direction: Horizontal, panes: [
            (size: "70%", borders: "NONE", pane: Split(direction: Vertical, panes: [
                (size: "2", borders: "TOP | RIGHT | LEFT", border_symbols: Rounded, pane: Pane(QueueHeader())),
                (size: "100%", borders: "ALL", border_symbols: Library("rounded_collapsed_top"),
                    border_title_position: Bottom,
                    border_title_alignment: Right,
                    pane: Pane(Queue)),
            ])),
            (size: "30%", borders: "NONE", pane: Split(direction: Vertical, panes: [
                (size: "0.25r", borders: "TOP | RIGHT | LEFT", border_symbols: Rounded, pane: Pane(AlbumArt)),
                (size: "100%", borders: "ALL", border_symbols: Library("rounded_collapsed_top"),
                    border_title: [(kind: Text("Lyrics"))],
                    border_title_position: Top,
                    border_title_alignment: Right,
                    pane: Pane(Lyrics)),
            ])),
        ])),
        (name: "Directories", pane: Split(direction: Horizontal,panes: [
            (size: "100%", borders: "ALL", border_symbols: Rounded, pane: Pane(Directories)),
        ])),
        (name: "Artists", pane: Split(direction: Horizontal, panes: [
            (size: "100%", borders: "ALL", border_symbols: Rounded, pane: Pane(Artists)),
        ])),
        (name: "Genre", pane: Split(direction: Horizontal, panes: [
            (size: "100%", borders: "ALL", border_symbols: Rounded, pane: Pane(Browser(root_tag: "genre", separator: ";"))),
        ])),
        (name: "Show",pane: Split(direction: Vertical, panes: [
            (size: "50%", pane: Split(direction: Horizontal, panes: [
                (size: "39%", borders: "ALL", border_symbols: Rounded, pane: Pane(Queue)),
                (size: "22%", borders: "ALL", border_symbols: Rounded, pane: Pane(AlbumArt)),
                (size: "39%", borders: "ALL",
                    border_title: [(kind: Text("Lyrics"))],
                    border_title_position: Top,
                    border_title_alignment: Right,
                    border_symbols: Rounded,
                    pane: Pane(Lyrics)),
            ])),
            (size: "50%", borders: "ALL", border_symbols: Rounded, pane: Pane(Cava)),
        ])),
        (name: "Playlists", pane: Split(direction: Horizontal, panes: [
            (size: "100%", borders: "ALL", border_symbols: Rounded, pane: Pane(Playlists)),
        ])),
        (name: "Search", pane: Split(direction: Horizontal, panes: [
            (size: "100%", borders: "ALL", border_symbols: Rounded, pane: Pane(Search)),
        ])),
    ],
)
