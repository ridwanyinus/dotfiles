#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    text_color: "#e5e1e4",
    background_color: None,
    modal_background_color: None,
    modal_backdrop: true,
    header_background_color: None,
    preview_label_style: (fg: "#c1c5e3"),
    preview_metadata_group_style: (fg: "#c1c5e3", modifiers: "Bold"),
    song_table_album_separator: None,
    tab_bar: (
        active_style: (fg: "#131315", bg: "#c1c5e3", modifiers: "Bold"),
        inactive_style: (fg: "#c6c5d3", modifiers: "Bold"),
    ),
    borders_style: (fg: "#c1c5e3"),
    highlighted_item_style: (fg: "#c1c5e3", modifiers: "Bold"),
    current_item_style: (fg: "#c1c5e3", bg: "#41455f", modifiers: "Bold"),
    highlight_border_style: (fg: "#c1c5e3"),
    symbols: (song: "󰝚 ", dir: "󱍙 ", playlist: "󰲸 ", marker: "* ", ellipsis: "...",
        song_style: (fg: "#c1c5e3"), dir_style: (fg: "#c1c5e3"),
    ),
    progress_bar: (
        symbols: ["[", "-", ">", " ", "]"],
        track_style: (fg:"#201f21",bg: None),
        elapsed_style: (fg: "#c1c5e3", bg: None),
        thumb_style: (fg: "#c1c5e3", bg: None),
        use_track_when_empty: false,
    ),
    scrollbar: (
        symbols: ["┋", "█", "󰄿", "󰄼"],
        track_style: (fg: "#c1c5e3"),
        ends_style: (fg: "#e2e1ef"),
        thumb_style: (fg: "#c1c5e3"),
    ),
    song_table_format: [
        (
         prop: (
            kind: Group([
                (kind: Text(" ")),
                (kind: Property(Artist))
            ]),
            style: (fg: "#c1c5e3"),
            default: (kind: Group([(kind: Text(" Unknown Artist"))]))
        ),
            width: "25%",
            label_prop: (kind: Group([
                (kind: Text("Artist "), style: (fg: "#e5e1e4")),
              (kind: Text(" " ), style: (fg: "#c1c5e3"))
            ]))
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#e1bcd3"),
                default: (kind: Property(Filename), style: (fg: "#e5e1e4"),
                    default: (kind: Text("Unknown Title"), style: (fg: "#e5e1e4")))),
            width: "40%",
            label_prop: (kind: Group([
                (kind: Text("Title "), style: (fg: "#e5e1e4")),
                (kind: Text(" "), style: (fg: "#c1c5e3"))
            ]))
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#c1c5e3"),
                default: (kind: Text("Unknown Album"))),
            width: "25%",
            label_prop: (kind: Group([
                (kind: Text("Album "), style: (fg: "#e5e1e4")),
                (kind: Text("󰀥 "), style: (fg: "#c1c5e3"))
            ]))
        ),
        (
            prop: (kind: Property(Duration), style: ( fg: "#e1bcd3"),
                default: (kind: Text("-"))),
            width: "10%",
            alignment: Right,
            label_prop: (kind: Group([
                (kind: Text("Length "), style: (fg: "#e5e1e4")),
                (kind: Text(" "), style: (fg: "#c1c5e3"))
            ]))
        ),
    ],
    layout: Split(
        direction: Vertical, panes: [
            (size: "6", borders: "NONE", pane: Component("header")),
            (size: "100%", borders: "NONE", pane: Pane(TabContent)),
            (size: "1", borders: "NONE", pane: Component("progress_bar")),
        ]),
    browser_song_format: [
        (kind: Group([
                    (kind: Property(Track)),
                    (kind: Text(" ")),
                ])),
        (kind: Group([
                    (kind: Property(Artist)),
                    (kind: Text(" - ")),
                    (kind: Property(Title)),
                ]), default: (kind: Property(Filename)))
    ],
    level_styles: (
        info: (fg: "#c1c5e3", bg: "#131315"),
        warn: (fg: "#e1bcd3", bg: "#131315"),
        error: (fg: "#ffb4ab", bg: "#131315"),
        debug: (fg: "#c6c5d3", bg: "#131315"),
        trace: (fg: "#5a3e51", bg: "#131315"),
    ),
    components: {
        "header_line_0": Split(direction: Horizontal, panes: [
                    (size: "12%", borders: "NONE", pane: Component("tab_bar_left")),
                    (size: "76%", borders: "NONE", pane: Pane(Tabs)),
                    (size: "12%", borders: "NONE", pane: Component("tab_bar_right")),
            ]),
        "header_line_1": Split(direction: Horizontal, panes: [
                            (size: "26%", pane: Component("header_element_1")),
                            (size: "48%", pane: Component("header_element_2")),
                            (size: "26%", pane: Component("header_element_3")),
                            (size: "2", pane: Component("header_element_right_end")),
            ]),
        "header_line_2": Split(direction: Horizontal, panes: [
                            (size: "26%", pane: Component("header_element_4")),
                            (size: "48%", pane: Component("header_element_5")),
                            (size: "26%", pane: Component("header_element_6")),
                            (size: "2", pane: Component("header_element_right_end")),
            ]),
        "header": Split(
            direction: Vertical, panes: [
                (size: "2", borders: "TOP | RIGHT | LEFT", border_symbols: Rounded,
                    pane: Split(direction: Horizontal, panes: [
                        (size: "100%", borders: "NONE", pane: Component("header_line_0")),
                  ])
                ),
                (size: "4", borders: "ALL", border_symbols: Library("rounded_collapsed_top"),
                  pane: Split(direction: Vertical, panes: [
                     (size: "100%", borders: "NONE", pane: Component("header_line_1")),
                     (size: "100%", borders: "NONE", pane: Component("header_line_2")),
                  ])
                ),
            ]
        ),
        "progress_bar": Split(
            direction: Vertical, panes: [
              (size: "3", borders: "NONE", border_symbols: Rounded ,
                  pane: Split(direction: Vertical, panes: [
                      (size: "100%", borders: "NONE",pane: Pane(ProgressBar)),
                ])
              ),
            ]
        ),
        "tab_bar_left": Split(direction: Horizontal, panes: [
             (size: "100%", pane: Pane(Property(content: [
                             (kind: Text(" "), style: (fg: "#c1c5e3", modifiers: "Bold")),
                             (kind: Property(Status(StateV2(playing_label: "", paused_label: "", stopped_label: ""))),
                                 style: (fg: "#e5e1e4")),
                             (kind: Text("  "), style: (fg: "#c1c5e3", modifiers: "Bold")),
                             (kind: Property(Song(FileExtension)), style: (fg: "#c6c5d3")),
                             (kind: Text(" ")),
                             (kind: Property(Widget(ScanStatus)), style: (fg: "#e5e1e4", modifiers: "Bold")),
                             (kind: Text(" ")),
                             (kind: Property(Status(InputBuffer())), style: (fg: "#c6c5d3")),
                         ], align: Left))
             ),
            ]),
        "tab_bar_right": Split(direction: Horizontal, panes: [
                 (size: "100%", pane: Pane(Property(content: [
                                 (kind: Text(" 󱡬"), style: (fg: "#c1c5e3", modifiers: "Bold")),
                                 (kind: Property(Status(Volume)), style: (fg: "#e5e1e4")),
                                 (kind: Text("% "), style: (fg: "#c1c5e3", modifiers: "Bold"))
                             ], align: Right))
                 ),
            ]),
        "header_element_1": Split(
            direction: Horizontal,
            panes: [
               (size: "100%", pane: Pane(Property(content: [
                               (kind: Text("[ "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                               (kind: Property(Status(Elapsed)),style: (fg: "#e5e1e4")),
                               (kind: Text(" 󱦟 "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                               (kind: Property(Status(Duration)),style: (fg: "#e5e1e4")),
                               (kind: Text(" ]"),style: (fg: "#c1c5e3", modifiers: "Bold")),
                           ], align: Left))
               ),
            ]
        ),
        "header_element_2": Split(
            direction: Horizontal,
            panes: [
                (size: "100%", pane: Pane(Property(content: [
                                (kind: Property(Song(Title)), style: (fg: "#e5e1e4",modifiers: "Bold"),
                                    default: (kind: Property(Song(Filename)), style: (fg: "#e5e1e4",modifiers: "Bold"),
                                        default: (kind: Text("Unknown Title"), style: (fg: "#e5e1e4",modifiers: "Bold"))))
                            ], align: Center))
                ),
            ]
        ),
        "header_element_3": Split(
            direction: Horizontal,
            panes: [
               (size: "100%", pane: Pane(Property(content: [
                         (kind: Text("[ "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                          (kind: Property(Status(RepeatV2(on_label: "", off_label: "󰑗",
                                         on_style: (fg: "#e5e1e4", modifiers: "Bold"),
                                         off_style: (fg: "#c6c5d3", modifiers: "Bold"))))),
                         (kind: Text(" | "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                          (kind: Property(Status(RandomV2(on_label: "", off_label: "",
                                         on_style: (fg: "#e5e1e4", modifiers: "Bold"),
                                         off_style: (fg: "#c6c5d3", modifiers: "Bold"))))),
                         (kind: Text(" | "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                         (kind: Property(Status(ConsumeV2(on_label: "󰮯", off_label: "󰮯", oneshot_label: "󰮯 󰇊",
                                         on_style: (fg: "#e5e1e4", modifiers: "Bold"),
                                         off_style: (fg: "#c6c5d3", modifiers: "Bold"))))),
                         (kind: Text(" | "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                         (kind: Property(Status(SingleV2(on_label: "󰎤", off_label: "󰎦", oneshot_label: "󰇊", off_oneshot_label: "󱅊",
                                         on_style: (fg: "#e5e1e4", modifiers: "Bold"),
                                         off_style: (fg: "#c6c5d3", modifiers: "Bold"))))),
                         (kind: Text(" | "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                         (kind: Property(Status(Crossfade)),style: (fg: "#c6c5d3"),
                          default: (kind: Text("󰴽"), style: (fg: "#c6c5d3"))),
                     ], align: Right))
               ),
            ]
        ),
        "header_element_4": Split(
            direction: Horizontal,
            panes: [
                 (size: "100%", pane: Pane(Property(content: [
                                 (kind: Text("[ "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                                 (kind: Property(Status(QueueTimeRemaining(separator: " "))),style: (fg: "#e5e1e4")),
                                 (kind: Text(" 󱎫  "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                                 (kind: Property(Status(QueueTimeTotal(separator: " "))),style: (fg: "#e5e1e4")),
                                  (kind: Text(" ]"),style: (fg: "#c1c5e3", modifiers: "Bold"))
                             ], align: Left))
                 ),
            ]
        ),
        "header_element_5": Split(
            direction: Horizontal,
            panes: [
                 (size: "100%", pane: Pane(Property(content: [
                                 (kind: Property(Song(Artist)), style: (fg: "#c1c5e3"),
                                     default: (kind: Text("Unknown Artist"))),
                                 (kind: Text("  "), style: (fg: "#e5e1e4")),
                                 (kind: Property(Song(Album)),style: (fg: "#c1c5e3" ),
                                     default: (kind: Text("Unknown Album"), style: (fg: "#c1c5e3")))
                             ], align: Center))
                 ),
            ]
        ),
        "header_element_6": Split(
            direction: Horizontal,
            panes: [
                   (size: "100%", pane: Pane(Property(content: [
                                   (kind: Text("[ "),style: (fg: "#c1c5e3", modifiers: "Bold")),
                                   (kind: Property(Song(Other("genre"))),style: (fg: "#e5e1e4"),
                                       default: (kind: Text("Unknown Genre"), style: (fg: "#5a3e51"))),
                               ], align: Right))
                   ),
            ]
        ),
        "header_element_right_end": Split(
            direction: Horizontal,
            panes: [
               (size: "100%", pane: Pane(Property(content: [
                               (kind: Text(" ]"),style: (fg: "#c1c5e3", modifiers: "Bold")),
                           ], align: Right))
               ),
            ]
        ),
    },
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bar_width: 1, bar_spacing: 1,
        bg_color: None,
        bar_color: Gradient({
            0: "#41455f",
            33: "#c1c5e3",
            67: "#e1bcd3",
            100: "#dee1ff",
            })
    ),
    lyrics:(timestamp: false),
    border_symbol_sets: {
    "rounded_collapsed_top": (
        parent: Rounded,
        top_left: "├",
        top_right: "┤",
        ),
    },
)


