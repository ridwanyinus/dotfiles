{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "bright": "#e6e1e7",
    "medium-bright": "#3b383d",
    "git-bg": "#fdafd8",
    "git-fg": "#521c3e",
    "medium": "#948e9a",
    "medium-dim": "#2b292e",
    "dim-bg": "#1d1b1f",
    "darker-bg": "#141317",
    "dark-bg": "#141317",
    "segment-bg": "#230e49",
    "os-bg": "#230e49",
    "root-bg": "#93000a",
    "path-bg": "#d2bbff",
    "error-fg": "#ffb4ab"
  },
  "transient_prompt": {
    "template": " ",
    "newline": true
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "<p:bright>╭─</>",
          "foreground": "p:bright"
        },
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "template": " {{ .Icon }} ",
          "foreground": "p:medium",
          "background": "p:os-bg"
        },
        {
          "background": "p:root-bg",
          "foreground": "p:bright",
          "style": "diamond",
          "template": "<parentBackground></>  ",
          "type": "root"
        },
        {
          "background": "p:path-bg",
          "foreground": "p:medium-bright",
          "trailing_diamond": "",
          "template": "<parentBackground></> 󰉖 {{ path .Path .Location }} ",
          "type": "path",
          "style": "diamond"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "git",
          "style": "diamond",
          "background": "p:path-bg",
          "foreground": "p:git-fg",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .HEAD }} ",
          "options": {
            "branch_icon": "",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "branch_template": "{{ trunc 25 .Branch }}"
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:bright",
          "style": "plain",
          "template": "{{ if eq .Code 0 }}╰─λ{{ else }}╰─{{ end }}",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4,
  "patch_pwsh_bleed": true,
  "final_space": true
}
