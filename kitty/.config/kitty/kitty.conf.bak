
#    __ ___ __  __
#   / //_(_) /_/ /___ __
#  / ,< / / __/ __/ // /
# /_/|_/_/\__/\__/\_, /
#                /___/
#
# Configuration
font_size                   11.5
remember_window_size  yes
initial_window_width        950
initial_window_height       500
cursor_blink_interval       0.5
cursor_stop_blinking_after  1
cursor_shape block
cursor_shape_unfocused hollow
shell_integration no-cursor
# cursor_trail 200
cursor_trail_start_threshold 4
cursor_trail 1
scrollback_lines            5000
wheel_scroll_min_lines      1
enable_audio_bell           no
window_padding_width        8
hide_window_decorations     yes
background_opacity          0.85
background_blur 1
confirm_os_window_close     0
allow_remote_control socket-only
listen_on unix:/tmp/kitty-socket
listen_on unix:@mykitty

disable_ligatures never
url_style curly
# selection_foreground        none
# selection_background        none

# Include Custom Configuration
# Create the file custom.conf in ~/.config/kitty to overwrite the default configuration
#include ./custom.conf;

include  colors-matugen.conf

# BEGIN_KITTY_THEME
# Noctalia
include current-theme.conf
# END_KITTY_THEME

sync_to_monitor yes

# Tab bar
tab_bar_edge bottom
tab_bar_margin_width 0.0
tab_bar_margin_height 0.0 0.0
tab_bar_style custom
tab_bar_align left
tab_bar_min_tabs 2
tab_separator ""
tab_activity_symbol none
tab_title_template " {tab.active_wd.rsplit('/', 1)[-1]} "
active_tab_title_template "~ {tab.active_wd.rsplit('/', 1)[-1]} " 

# tab_bar_margin_width      4
# tab_bar_margin_height     4 0
# tab_bar_style             separator
# tab_bar_min_tabs          2
# tab_separator             ""
# tab_title_template        "{fmt.fg.color0}{fmt.bg.default}{fmt.fg.color15}{fmt.bg.color0} 󰄛 {title[:15] + (title[15:] and '…')} {fmt.fg.color0}{fmt.bg.default} "
# active_tab_title_template "{fmt.fg.color4}{fmt.bg.default}{fmt.fg.color0}{fmt.bg.color4} 󰄛 {title[:40] + (title[40:] and '…')} {fmt.fg.color4}{fmt.bg.default} "

enabled_layouts splits:split_axis=horizontal

# Scroll up/down by line
map ctrl+shift+up    scroll_line_up
map ctrl+shift+down  scroll_line_down

# Scroll up/down by page
map ctrl+shift+page_up   scroll_page_up
map ctrl+shift+page_down scroll_page_down

# Scroll to top/bottom
map ctrl+shift+home  scroll_home
map ctrl+shift+end   scroll_end
map F5 launch --location=hsplit
map F6 launch --location=vsplit
map F7 layout_action rotate

# map ctrl+t new_tab
# map ctrl+w close_tab

# Move the active window in the indicated direction
map shift+up move_window up
map shift+left move_window left
map shift+right move_window right
map shift+down move_window down

# default window navigation
# Ctrl + Shift + [ - Move to previous window
# Ctrl + Shift + ] - Move to next window

#shell
shell /usr/bin/fish


# BEGIN_KITTY_FONTS
font_family      family='Maple Mono Light' postscript_name=MapleMono-Regular
bold_font        auto
italic_font      family='Maple Mono' style='Thin Italic'
bold_italic_font auto
# END_KITTY_FONTS
